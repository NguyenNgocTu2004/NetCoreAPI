@model DemoMVC.ViewModels.PaginationViewModel

@{
    string PageUrl(int page)
    {
        var routeValues = new Dictionary<string, object?>(Model.RouteValues)
        {
            ["page"] = page
        };
        if (!string.IsNullOrWhiteSpace(Model.SearchString))
        {
            routeValues["searchString"] = Model.SearchString;
        }
        return Url.Action(Model.Action, routeValues) ?? "#";
    }
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mt-3">
    <div class="text-muted">
        @if (Model.TotalItems > 0)
        {
            <span>Đang hiển thị @Model.FirstItem-@Model.LastItem trên @Model.TotalItems bản ghi.</span>
        }
        else
        {
            <span>Không có bản ghi nào.</span>
        }
        <span class="ms-2">Trang @Model.CurrentPage / @Model.TotalPages.</span>
    </div>

    @if (Model.TotalPages > 1)
    {
        <nav aria-label="Điều hướng phân trang">
            <ul class="pagination pagination-sm mb-0">
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@(Model.CurrentPage == 1 ? "#" : PageUrl(1))" aria-label="Trang đầu">Đầu</a>
                </li>
                <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                    <a class="page-link" href="@(Model.CurrentPage == 1 ? "#" : PageUrl(Model.CurrentPage - 1))" aria-label="Trang trước">Trước</a>
                </li>
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                        <a class="page-link" href="@PageUrl(pageNumber)" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                            @pageNumber
                        </a>
                    </li>
                }
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@(Model.CurrentPage == Model.TotalPages ? "#" : PageUrl(Model.CurrentPage + 1))" aria-label="Trang tiếp">Tiếp</a>
                </li>
                <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                    <a class="page-link" href="@(Model.CurrentPage == Model.TotalPages ? "#" : PageUrl(Model.TotalPages))" aria-label="Trang cuối">Cuối</a>
                </li>
            </ul>
        </nav>
    }
</div>
