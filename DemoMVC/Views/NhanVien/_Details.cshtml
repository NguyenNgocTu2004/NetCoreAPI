@model DemoMVC.Models.NhanVien

@{
    var isDelete = ViewData["IsDelete"] as bool? == true;
}

<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.MaNhanVien)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.MaNhanVien)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.HoTen)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.HoTen)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.ChucVu)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.ChucVu)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PhongBan)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.PhongBan)</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Luong)</dt>
    <dd class="col-sm-9">@Html.DisplayFor(model => model.Luong)</dd>
</dl>

@if (isDelete)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input asp-for="Id" type="hidden" />
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        </div>
    </form>
}
else
{
    <div class="d-flex justify-content-end gap-2">
        <a asp-action="Edit"
           asp-route-id="@Model.Id"
           class="btn btn-warning"
           data-crud-modal
           data-modal-title="Sửa nhân viên">
            Sửa
        </a>
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    </div>
}
