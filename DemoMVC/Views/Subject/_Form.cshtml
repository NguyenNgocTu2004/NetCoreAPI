@model DemoMVC.Models.Subject

@{
    var actionName = Model.Id == 0 ? "Create" : "Edit";
}

<form asp-action="@actionName" asp-route-id="@(Model.Id == 0 ? (int?)null : Model.Id)" method="post">
    <input asp-for="Id" type="hidden" />
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="mb-3">
        <label asp-for="MaMonHoc" class="form-label"></label>
        <input asp-for="MaMonHoc" class="form-control" />
        <span asp-validation-for="MaMonHoc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="TenMonHoc" class="form-label"></label>
        <input asp-for="TenMonHoc" class="form-control" />
        <span asp-validation-for="TenMonHoc" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="SoTinChi" class="form-label"></label>
        <input asp-for="SoTinChi" type="number" min="1" step="1" class="form-control" />
        <span asp-validation-for="SoTinChi" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="MoTa" class="form-label"></label>
        <textarea asp-for="MoTa" class="form-control" rows="3"></textarea>
        <span asp-validation-for="MoTa" class="text-danger"></span>
    </div>
    <div class="d-flex justify-content-end gap-2">
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
        <button type="submit" class="btn btn-primary">Lưu</button>
    </div>
</form>
