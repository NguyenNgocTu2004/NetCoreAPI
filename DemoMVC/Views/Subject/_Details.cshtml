@model DemoMVC.Models.Subject

@{
    var isDelete = ViewData["IsDelete"] as bool? == true;
    var canManageData = User.IsInRole(IdentitySeeder.AdminRole) || User.IsInRole(IdentitySeeder.DepartmentRole);
}

<dl class="row">
    <dt class="col-sm-3">Mã môn học</dt>
    <dd class="col-sm-9">@Model.MaMonHoc</dd>
    <dt class="col-sm-3">Tên môn học</dt>
    <dd class="col-sm-9">@Model.TenMonHoc</dd>
    <dt class="col-sm-3">Số tín chỉ</dt>
    <dd class="col-sm-9">@Model.SoTinChi</dd>
    <dt class="col-sm-3">Mô tả</dt>
    <dd class="col-sm-9">@Model.MoTa</dd>
    <dt class="col-sm-3">Bản ghi điểm</dt>
    <dd class="col-sm-9">@Model.Grades.Count</dd>
</dl>

@if (isDelete && canManageData)
{
    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
        <input type="hidden" name="id" value="@Model.Id" />
        <div class="d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
            <button type="submit" class="btn btn-danger">Xác nhận xóa</button>
        </div>
    </form>
}
else
{
    <div class="d-flex justify-content-end gap-2">
        @if (canManageData && !isDelete)
        {
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning"
               data-crud-modal data-modal-title="Sửa môn học">Sửa</a>
        }
        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Đóng</button>
    </div>
}
