@model DemoMVC.ViewModels.PagedResult<DemoMVC.Models.Subject>
@{
    var canManageData = User.IsInRole(IdentitySeeder.AdminRole) || User.IsInRole(IdentitySeeder.DepartmentRole);
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã môn học</th>
            <th>Tên môn học</th>
            <th>Số tín chỉ</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.MaMonHoc</td>
                <td>@item.TenMonHoc</td>
                <td>@item.SoTinChi</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm"
                       data-crud-modal data-modal-title="Chi tiết môn học">Xem</a>
                    @if (canManageData)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"
                           data-crud-modal data-modal-title="Sửa môn học">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"
                           data-crud-modal data-modal-title="Xóa môn học">Xóa</a>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="4" class="py-4 text-center text-muted">Không có môn học phù hợp.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model='new DemoMVC.ViewModels.PaginationViewModel {
    CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages,
    TotalItems = Model.TotalItems, PageSize = Model.PageSize,
    FirstItem = Model.FirstItem, LastItem = Model.LastItem,
    Action = "Index",
    SearchString = ViewContext.HttpContext.Request.Query["searchString"]
}' />
