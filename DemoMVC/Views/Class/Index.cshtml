@model IEnumerable<DemoMVC.Models.StudentClass>

@{
    ViewData["Title"] = "Quản lý lớp học";
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<h1>Quản lý lớp học</h1>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input name="searchString" value="@currentFilter" class="form-control"
               placeholder="Tìm theo mã lớp, tên lớp hoặc ngành học" />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">Xóa bộ lọc</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary" data-crud-modal
       data-modal-title="Thêm lớp học">+ Thêm lớp học</a>
</p>

<div data-list-url="@Url.Action("List")">
    <partial name="_ClassTable" model="Model" />
</div>
