@model IEnumerable<DemoMVC.Models.StudentClass>
@{
    var canManageData = User.IsInRole(IdentitySeeder.AdminRole) || User.IsInRole(IdentitySeeder.DepartmentRole);
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã lớp</th>
            <th>Tên lớp</th>
            <th>Ngành học</th>
            <th>Khóa học</th>
            <th>Số sinh viên</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.MaLop</td>
                <td>@item.TenLop</td>
                <td>@item.NganhHoc</td>
                <td>@item.KhoaHoc</td>
                <td>@item.Students.Count</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm"
                       data-crud-modal data-modal-title="Chi tiết lớp học">Xem</a>
                    @if (canManageData)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"
                           data-crud-modal data-modal-title="Sửa lớp học">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"
                           data-crud-modal data-modal-title="Xóa lớp học">Xóa</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
