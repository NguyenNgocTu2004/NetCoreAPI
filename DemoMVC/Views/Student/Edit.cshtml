@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Sửa sinh viên";
}

<h1>Sửa sinh viên</h1>

<form asp-action="Edit" method="post">

    <input type="hidden" asp-for="Id" />

    <div class="mb-3">

        <label class="form-label">
            Họ tên
        </label>

        <input asp-for="FullName"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            Trường
        </label>

        <input asp-for="School"
               class="form-control" />

    </div>


    <div class="mb-3">

        <label class="form-label">
            Địa chỉ
        </label>

        <input asp-for="Address"
               class="form-control" />

    </div>


    <button type="submit"
            class="btn btn-success">
        Lưu thay đổi
    </button>

    <a asp-action="Index"
       class="btn btn-secondary">
        Quay lại
    </a>

</form>