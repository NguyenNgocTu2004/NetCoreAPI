@model DemoMVC.Models.Student

@{
    ViewData["Title"] = "Chi tiết sinh viên";
}

<h1>Chi tiết sinh viên</h1>

<hr />

<div class="card">
    <div class="card-body">

        <dl class="row">

            <!-- ID -->
            <dt class="col-sm-3">
                ID
            </dt>

            <dd class="col-sm-9">
                @Model.Id
            </dd>

            <!-- Mã sinh viên -->
            <dt class="col-sm-3">
                Mã sinh viên
            </dt>

            <dd class="col-sm-9">
                @Model.StudentCode
            </dd>

            <!-- Họ tên -->
            <dt class="col-sm-3">
                Họ tên
            </dt>

            <dd class="col-sm-9">
                @Model.FullName
            </dd>

            <!-- Trường -->
            <dt class="col-sm-3">
                Trường
            </dt>

            <dd class="col-sm-9">
                @Model.School
            </dd>

            <!-- Địa chỉ -->
            <dt class="col-sm-3">
                Địa chỉ
            </dt>

            <dd class="col-sm-9">
                @Model.Address
            </dd>

        </dl>

    </div>
</div>

<br />

<a asp-action="Edit"
   asp-route-id="@Model.Id"
   class="btn btn-warning">
    Sửa
</a>

<a asp-action="Index"
   class="btn btn-secondary">
    Quay lại
</a>