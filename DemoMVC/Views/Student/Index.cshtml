@model IEnumerable<DemoMVC.Models.Student>

@{
    ViewData["Title"] = "Bảng dữ liệu sinh viên";
}

<h1>Bảng dữ liệu sinh viên</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

<div class="mb-3">
    <a asp-action="Create" class="btn btn-primary">
        + Thêm sinh viên
    </a>
</div>

<table class="table table-bordered table-striped">

    <thead>
        <tr>
            <th>ID</th>
            <th>Họ tên</th>
            <th>Trường</th>
            <th>Địa chỉ</th>
            <th>Chức năng</th>
        </tr>
    </thead>

    <tbody>

        @foreach (var student in Model)
        {
            <tr>

                <td>
                    @student.Id
                </td>

                <td>
                    @student.FullName
                </td>

                <td>
                    @student.School
                </td>

                <td>
                    @student.Address
                </td>

                <td>

                    <a asp-action="Details"
                       asp-route-id="@student.Id"
                       class="btn btn-info btn-sm">
                        Xem
                    </a>

                    <a asp-action="Edit"
                       asp-route-id="@student.Id"
                       class="btn btn-warning btn-sm">
                        Sửa
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@student.Id"
                       class="btn btn-danger btn-sm">
                        Xóa
                    </a>

                </td>

            </tr>
        }

    </tbody>

</table>