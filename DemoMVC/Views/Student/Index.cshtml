@model IEnumerable<DemoMVC.Models.Student>

@{
    ViewData["Title"] = "Bảng dữ liệu sinh viên";
    var currentFilter = ViewData["CurrentFilter"] as string;
}

<h1>Bảng dữ liệu sinh viên</h1>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-8">
        <input type="text"
               name="searchString"
               value="@currentFilter"
               class="form-control"
               placeholder="Tìm theo mã, họ tên, email, lớp, trường hoặc địa chỉ" />
    </div>
    <div class="col-md-4 d-flex gap-2">
        <button type="submit" class="btn btn-primary flex-fill">
            Tìm kiếm
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary flex-fill">
            Làm mới
        </a>
    </div>
</form>

<p>
    <a asp-action="Create"
       class="btn btn-primary"
       data-crud-modal
       data-modal-title="Thêm sinh viên">
        + Thêm sinh viên
    </a>
</p>

<div id="student-table-container" data-list-url="@Url.Action("List")">
    <partial name="_StudentTable" model="Model" />
</div>
