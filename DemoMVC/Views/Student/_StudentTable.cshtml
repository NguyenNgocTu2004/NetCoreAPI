@model DemoMVC.ViewModels.PagedResult<DemoMVC.Models.Student>
@{
    var canManageData = User.IsInRole(IdentitySeeder.AdminRole) || User.IsInRole(IdentitySeeder.DepartmentRole);
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>ID</th>
            <th>Mã sinh viên</th>
            <th>Họ tên</th>
            <th>Email</th>
            <th>Lớp</th>
            <th>Trường</th>
            <th>Địa chỉ</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var student in Model.Items)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.StudentCode</td>
                <td>@student.FullName</td>
                <td>@student.Email</td>
                <td>@(student.Class?.TenLop ?? "Chưa xếp lớp")</td>
                <td>@student.School</td>
                <td>@student.Address</td>
                <td class="text-nowrap">
                    <a asp-action="Details"
                       asp-route-id="@student.Id"
                       class="btn btn-info btn-sm"
                       data-crud-modal
                       data-modal-title="Chi tiết sinh viên">
                        Xem
                    </a>
                    @if (canManageData)
                    {
                        <a asp-action="Edit"
                           asp-route-id="@student.Id"
                           class="btn btn-warning btn-sm"
                           data-crud-modal
                           data-modal-title="Sửa sinh viên">
                            Sửa
                        </a>
                        <a asp-action="Delete"
                           asp-route-id="@student.Id"
                           class="btn btn-danger btn-sm"
                           data-crud-modal
                           data-modal-title="Xóa sinh viên">
                            Xóa
                        </a>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr>
                <td colspan="8" class="py-4 text-center text-muted">Không có sinh viên phù hợp.</td>
            </tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model='new DemoMVC.ViewModels.PaginationViewModel {
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.TotalPages,
    TotalItems = Model.TotalItems,
    PageSize = Model.PageSize,
    FirstItem = Model.FirstItem,
    LastItem = Model.LastItem,
    Action = "Index",
    SearchString = ViewContext.HttpContext.Request.Query["searchString"],
    RouteValues = new Dictionary<string, object?> {
        ["classId"] = ViewContext.HttpContext.Request.Query["classId"].ToString()
    }
}' />
