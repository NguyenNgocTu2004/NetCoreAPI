@model DemoMVC.ViewModels.PagedResult<ManagedUserViewModel>
@{
    ViewData["Title"] = "Quản lý tài khoản";
    var currentFilter = ViewData["CurrentFilter"] as string ?? string.Empty;
    var roleFilter = ViewData["RoleFilter"] as string ?? string.Empty;
    var statusFilter = ViewData["StatusFilter"] as string ?? string.Empty;
    var canManageAccounts = User.IsInRole("Admin");
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h1 class="h2 mb-1">Quản lý tài khoản</h1>
        <p class="text-muted mb-0">Danh sách người dùng và vai trò được cấp.</p>
    </div>

    @if (canManageAccounts)
    {
        <a asp-action="Create" class="btn btn-primary">Tạo tài khoản</a>
    }
</div>

@if (TempData["Success"] is string success)
{
    <div class="alert alert-success" role="status">@success</div>
}
@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger" role="alert">@error</div>
}

<form asp-action="Index" method="get" class="row g-2 align-items-end mb-4">
    <div class="col-12 col-md-6">
        <label for="searchString" class="form-label">Tìm theo tên đăng nhập hoặc email</label>
        <input id="searchString" name="searchString" value="@currentFilter" class="form-control" />
    </div>
    <div class="col-12 col-md-3">
        <label for="roleFilter" class="form-label">Lọc theo vai trò</label>
        <select id="roleFilter" name="roleFilter" class="form-select">
            <option value="">Tất cả vai trò</option>
            <option value="Admin" selected="@(roleFilter == "Admin")">Admin</option>
            <option value="DP" selected="@(roleFilter == "DP")">DP</option>
            <option value="User" selected="@(roleFilter == "User")">User</option>
        </select>
    </div>
    <div class="col-12 col-md-auto d-flex gap-2">
        <button type="submit" class="btn btn-outline-primary">Tìm kiếm</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
    </div>
</form>

<div class="mb-3">
    <span class="fw-semibold me-2">Trạng thái:</span>
    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-roleFilter="@roleFilter"
       asp-route-statusFilter="" class="btn btn-sm @(statusFilter == "" ? "btn-primary" : "btn-outline-primary")">Tất cả</a>
    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-roleFilter="@roleFilter"
       asp-route-statusFilter="active" class="btn btn-sm @(statusFilter == "active" ? "btn-primary" : "btn-outline-primary")">Hoạt động</a>
    <a asp-action="Index" asp-route-searchString="@currentFilter" asp-route-roleFilter="@roleFilter"
       asp-route-statusFilter="locked" class="btn btn-sm @(statusFilter == "locked" ? "btn-primary" : "btn-outline-primary")">Đang khóa</a>
</div>

<div class="table-responsive bg-white rounded-3 shadow-sm">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th scope="col">Tên đăng nhập</th>
                <th scope="col">Email</th>
                <th scope="col">Vai trò</th>
                <th scope="col">Trạng thái</th>
                @if (canManageAccounts)
                {
                    <th scope="col">Thao tác</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var user in Model.Items)
            {
                <tr>
                    <td>
                        <span class="fw-semibold">@user.Username</span>
                        @if (user.IsCurrentUser)
                        {
                            <span class="badge text-bg-secondary ms-1">Bạn</span>
                        }
                    </td>
                    <td>@(string.IsNullOrWhiteSpace(user.Email) ? "—" : user.Email)</td>
                    <td>@user.Roles</td>
                    <td>
                        @if (user.IsLockedOut)
                        {
                            <span class="badge text-bg-danger">Đang khóa</span>
                        }
                        else
                        {
                            <span class="badge text-bg-success">Hoạt động</span>
                        }
                    </td>
                    @if (canManageAccounts)
                    {
                        <td>
                            @if (!user.IsAdmin && !user.IsCurrentUser)
                            {
                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-action="ChangeRole" method="post" class="d-flex gap-2">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <select name="role" class="form-select form-select-sm" aria-label="Vai trò mới của @user.Username">
                                            <option value="User" selected="@(user.SelectedRole == "User")">User</option>
                                            <option value="DP" selected="@(user.SelectedRole == "DP")">DP</option>
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-outline-primary">Lưu</button>
                                    </form>
                                    <form asp-action="Delete" method="post"
                                          onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản này?');">
                                        <input type="hidden" name="id" value="@user.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Xóa</button>
                                    </form>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted">Không thể chỉnh sửa</span>
                            }
                        </td>
                    }
                </tr>
            }
            @if (Model.Items.Count == 0)
            {
                <tr>
                    <td colspan="@(canManageAccounts ? 5 : 4)" class="py-4 text-center text-muted">
                        Không tìm thấy tài khoản phù hợp.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<partial name="_Pagination" model='new DemoMVC.ViewModels.PaginationViewModel {
    CurrentPage = Model.CurrentPage,
    TotalPages = Model.TotalPages,
    TotalItems = Model.TotalItems,
    PageSize = Model.PageSize,
    FirstItem = Model.FirstItem,
    LastItem = Model.LastItem,
    Action = "Index",
    SearchString = currentFilter,
    RouteValues = new Dictionary<string, object?> {
        ["roleFilter"] = roleFilter,
        ["statusFilter"] = statusFilter
    }
}' />
