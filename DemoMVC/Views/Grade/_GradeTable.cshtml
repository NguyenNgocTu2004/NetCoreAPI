@model DemoMVC.ViewModels.PagedResult<DemoMVC.Models.Grade>
@{
    var canManageData = User.IsInRole(IdentitySeeder.AdminRole) || User.IsInRole(IdentitySeeder.DepartmentRole);
}

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Mã sinh viên</th>
            <th>Sinh viên</th>
            <th>Lớp</th>
            <th>Môn học</th>
            <th>Quá trình</th>
            <th>Thi</th>
            <th>Tổng kết</th>
            <th>Xếp loại</th>
            <th>Chức năng</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Items)
        {
            <tr>
                <td>@item.Student?.StudentCode</td>
                <td>@item.Student?.FullName</td>
                <td>@(item.Student?.Class?.TenLop ?? "Chưa xếp lớp")</td>
                <td>@item.Subject?.TenMonHoc</td>
                <td>@item.DiemQuaTrinh.ToString("0.00")</td>
                <td>@item.DiemThi.ToString("0.00")</td>
                <td>@item.DiemTongKet.ToString("0.00")</td>
                <td>@item.XepLoai</td>
                <td class="text-nowrap">
                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-info btn-sm"
                       data-crud-modal data-modal-title="Chi tiết điểm">Xem</a>
                    @if (canManageData)
                    {
                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm"
                           data-crud-modal data-modal-title="Sửa điểm">Sửa</a>
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger btn-sm"
                           data-crud-modal data-modal-title="Xóa điểm">Xóa</a>
                    }
                </td>
            </tr>
        }
        @if (Model.Items.Count == 0)
        {
            <tr><td colspan="9" class="py-4 text-center text-muted">Không có dữ liệu điểm phù hợp.</td></tr>
        }
    </tbody>
</table>
<partial name="_Pagination" model='new DemoMVC.ViewModels.PaginationViewModel {
    CurrentPage = Model.CurrentPage, TotalPages = Model.TotalPages,
    TotalItems = Model.TotalItems, PageSize = Model.PageSize,
    FirstItem = Model.FirstItem, LastItem = Model.LastItem,
    Action = "Index",
    SearchString = ViewContext.HttpContext.Request.Query["searchString"],
    RouteValues = new Dictionary<string, object?> {
        ["classId"] = ViewContext.HttpContext.Request.Query["classId"].ToString(),
        ["subjectId"] = ViewContext.HttpContext.Request.Query["subjectId"].ToString()
    }
}' />
